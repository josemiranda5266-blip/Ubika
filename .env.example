# Public application configuration
GEMINI_API_KEY=""
APP_URL="https://tu-dominio.example"

# Authentication
# Use a random secret of at least 32 characters in production.
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="24h"
INITIAL_ADMIN_PASSWORD="CHANGE_ME_TO_A_STRONG_PASSWORD"

# Email: console/mock are for local development and tests only.
EMAIL_PROVIDER="sendgrid"
EMAIL_FROM="no-reply@ubika.app"
SENDGRID_API_KEY=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# Payments (optional until the integration is enabled)
MERCADO_PAGO_ACCESS_TOKEN=""

# Argentina fiscal integration. Keep empty until real ARCA credentials/configuration exist.
ARCA_CUIT=""
ARCA_POINT_OF_SALE=""
