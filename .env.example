# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where UBIKA is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key used to sign and verify JSON Web Tokens. Use >= 32 random characters in production.
JWT_SECRET=CHANGE_ME

# INITIAL_ADMIN_PASSWORD: Optional initial administrator password for a fresh database.
INITIAL_ADMIN_PASSWORD=CHANGE_ME

# Perimeter hardening. Leave TRUST_PROXY_HOPS=0 unless UBIKA is deployed behind a known trusted reverse proxy chain.
TRUST_PROXY_HOPS=0
# Comma-separated exact browser origins allowed to call the API, e.g. https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=""

# Email Service Configuration
EMAIL_PROVIDER="console" # Options: console, sendgrid, smtp, mock
EMAIL_FROM="no-reply@ubika.app"
SENDGRID_API_KEY=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
