# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key used to sign and verify JSON Web Tokens for authentication.
JWT_SECRET=CHANGE_ME

# INITIAL_ADMIN_PASSWORD: The initial password for administrative accounts. Must be configured securely in production.
INITIAL_ADMIN_PASSWORD=CHANGE_ME

# Email Service Configuration
EMAIL_PROVIDER="console" # Options: console, sendgrid, smtp, mock
EMAIL_FROM="no-reply@ubika.app"
SENDGRID_API_KEY=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

